# Keys, one account, no way onwards.
#
# `UsePAM` is deliberately absent: Alpine's OpenSSH is built without PAM and
# refuses the option outright ("Unsupported option UsePAM"), which stops sshd
# from reading the rest of this file.
Port 22

# In the volume, not in /etc/ssh: the engine sets
# `StrictHostKeyChecking=accept-new`, so a key regenerated by a redeploy is
# *refused* for every developer at once, with a message that reads like an
# attack. One algorithm, because "did the key survive" should be one question.
HostKey /etc/ssh/keys/ssh_host_ed25519_key

# Composed by the entrypoint from the environment and the optional mounted
# file, outside any home directory so the account needs no writable one.
AuthorizedKeysFile /run/ddev-sync/authorized_keys

# The image has exactly one account and no reason for a second.
AllowUsers sync
PermitRootLogin no

# Keys only. There is no mode in which this endpoint accepts anyone: an image
# whose authentication could be switched off would reach production by
# accident and be invisible in `docker ps`.
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

# The endpoint is a destination, never a way onwards. The engine opens its own
# hop *to* here through the Docker host; nothing needs to forward out of here,
# and a compromised endpoint should not be able to reach the rest of the
# stack's network on anyone's behalf. All five, because the claim is "never",
# and `AllowStreamLocalForwarding` defaults to yes - today nothing in this
# container listens on a Unix socket, which makes the omission a wrong
# sentence rather than an open door.
AllowTcpForwarding no
AllowStreamLocalForwarding no
AllowAgentForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no

# Every developer who may sync shares this one account, so anything one of
# them can leave behind runs in the others' sessions. `~/.ssh/rc` is the only
# such hook sshd offers, and nothing here wants it.
PermitUserRC no

# Off, and this is a deliberate availability trade rather than an oversight.
# OpenSSH 9.8 and newer penalise a *source address* for connections that fail
# to authenticate, refusing it for up to ten minutes. Every developer reaches
# this endpoint through the same Docker host, so they all share one bucket:
# one stale key retrying in someone's loop would lock the whole team out, with
# "Connection closed by remote host" and nothing to point at the cause. The
# address carries no information here, so penalising it punishes the wrong
# people. What protects this endpoint is that it accepts keys only and is
# published on the host's loopback address alone - not rate limiting.
PerSourcePenalties no

PrintMotd no
LogLevel INFO
