# Production's own .env, as the endpoint mounts it. In `remote-only/` rather
# than `remote/`, like WordPress's wp-config.php: it exists on the production
# host and belongs to no mapped path, so no sync ever pulls it.
#
# The host is a compose service name, which is the point: the endpoint
# resolves it because it shares the stack's network, and that is what makes
# "the endpoint needs no credentials of its own" true rather than hopeful.
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_URL=https://mxdocker.example
DB_CONNECTION=mysql
DB_HOST=remote-db
DB_PORT=3306
DB_DATABASE=acme_prod
DB_USERNAME=acme
DB_PASSWORD=s3cret
