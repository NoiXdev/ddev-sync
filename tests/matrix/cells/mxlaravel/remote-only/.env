# Production's environment file. It belongs to no mapped path, so only
# `env.pull` reads it. The tricky value is in double quotes with phpdotenv's
# escapes (single quotes have none and could not hold its `'`), so the sync
# copies it raw. `x="y` stands in double quotes too: in single quotes phpdotenv's
# line grouping would take it for the start of a multi-line value.
PULLED_PLAIN=plain-value
PULLED_TRICKY=" pa'ss\"#=\$ word "
PULLED_EQUALS_QUOTE="x=\"y"
